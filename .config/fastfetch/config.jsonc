// Inspired by Catnap (https://github.com/iinsertNameHere/catnap)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
      "type": "file",
      "source": "~/.config/fastfetch/cat.txt",
      "color": {
          "1": "white",
      }
    },
    "display": {
        "separator": "",
        "key": {
            "width": 15
        }
    },
    "modules": [
        {
            // draw borders first to make colors of left and right border consistant
            "key": " user",
            "type": "title",
            "format": "{user-name}",
            "keyColor": "31"
        },
        {
            "key": "󰅐 uptime",
            "type": "uptime",
            "keyColor": "33"
        },
        {
            "key": "{icon} distro",
            "type": "os",
            "keyColor": "34"
        },
        {
            "key": "󰇄 desktop",
            "type": "de",
            "keyColor": "36"
        },
        {
            "key": " shell",
            "type": "shell",
            "keyColor": "32"
        },
        {
            "type": "colors",
            "symbol": "circle",
            "keyColor": "39"
        }
    ]
}
