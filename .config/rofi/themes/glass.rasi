/* ============================================================
   GLASS — Rofi Theme
   ============================================================ */

configuration {
    modi:              "drun,emoji,filebrowser";
    show-icons:        true;
    icon-theme:        "Papirus-Dark";
    font:              "JetBrainsMono Nerd Font 12";
    drun-display-format: "{name}";
    display-drun:      "";
    display-emoji:     "󰞅";
    display-filebrowser: "󰉋";
    show-match:        true;
    kb-mode-next:      "Control+Tab";
    kb-mode-previous:  "Control+ISO_Left_Tab";
}

* {
    base:        rgba(10, 10, 14, 0.50);
    surface:     rgba(255, 255, 255, 0.06);
    accent:      #7c8ff7;
    accent-dim:  rgba(124, 143, 247, 0.18);
    text-bright: #f0f0f5;
    text-mid:    rgba(240, 240, 245, 0.55);
    text-dim:    rgba(240, 240, 245, 0.28);
    border-lo:   rgba(255, 255, 255, 0.06);
    border-hi:   rgba(124, 143, 247, 0.45);
    background-color: transparent;
    text-color:       @text-bright;
}

window {
    width:            700px;
    background-color: @base;
    border-radius:    20px;
    border:           1px solid;
    border-color:     @border-lo;
    padding:          0px;
}

mainbox {
    background-color: transparent;
    children:         [inputbar, listview];
    spacing:          0px;
    padding:          0px;
}

inputbar {
    background-color: @surface;
    border-radius:    20px 20px 0px 0px;
    children:         [prompt, entry];
    padding:          14px 16px;
    spacing:          10px;
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    vertical-align:   0.5;
}

entry {
    background-color:  transparent;
    text-color:        @text-bright;
    placeholder:       "search apps…";
    placeholder-color: @text-dim;
    vertical-align:    0.5;
    expand:            true;
}

listview {
    background-color: transparent;
    lines:            3;
    columns:          4;
    spacing:          6px;
    padding:          12px;
    scrollbar:        false;
    fixed-height:     true;
}

element {
    background-color: transparent;
    border-radius:    12px;
    padding:          12px 6px;
    spacing:          6px;
    orientation:      vertical;
    children:         [element-icon, element-text];
}

element normal.normal {
    background-color: transparent;
    text-color:       @text-mid;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @text-mid;
}

element selected.normal {
    background-color: @accent-dim;
    border:           1px solid;
    border-color:     @border-hi;
    text-color:       @text-bright;
}

element-icon {
    size:             36px;
    horizontal-align: 0.5;
    background-color: transparent;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
}

message {
    background-color: transparent;
    padding:          0px 8px;
}

textbox {
    background-color: rgba(255, 80, 80, 0.10);
    border-radius:    8px;
    padding:          6px 12px;
    text-color:       rgba(255, 140, 140, 0.90);
}
